{
  "expo": {
    "name": "CODEX",
    "slug": "CODEX",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/codex.png",
    "scheme": "codex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/codex.png",
        "backgroundImage": "./assets/images/codex.png",
        "monochromeImage": "./assets/images/codex.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/codex.png",
      "bundler": "metro"
    },
    "plugins": [
      "react-native-bottom-tabs",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
